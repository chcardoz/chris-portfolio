{
  "name": "florence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@cbrain/site --",
    "build": "turbo build --filter=@cbrain/site",
    "start": "turbo start --filter=@cbrain/site",
    "brain": "turbo brain --filter=@cbrain/cli --",
    "mcp": "turbo mcp --filter=@cbrain/mcp",
    "typecheck": "turbo typecheck --filter='./apps/*' --filter='./packages/*'",
    "lint": "oxlint --deny-warnings apps packages",
    "test": "turbo test --filter='./apps/*' --filter='./packages/*'",
    "format": "oxfmt --check .",
    "lint:fix": "bun run lint --fix",
    "format:write": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.5",
    "next": "^16.4.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.2"
}
